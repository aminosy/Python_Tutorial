"""
一个包含学生年龄的列表
1.定义这个列表，并用变量接收它
2.追加一个数字31，到列表的底部
3.追加一个新列表[29,33,30]，到列表的尾部
4.取出第一个元素（应是：21）
5.取出最后一个元素（应是：30）
6.查找元素31，在列表中的下标位置
"""

#1.
age_list = [ 21 , 25 , 21 , 23 , 22 , 20]

#2.
age_list.append(31)
print(age_list)

#3.
age_list1 = [ 29 , 33 , 30]
age_list.extend(age_list1)
print(age_list)

#4.
first_num = age_list.pop(0)
print(first_num)

#5.
last_num = age_list.pop(-1)
print(last_num)

#6.
print(age_list.index(31))
